{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"command": "npm run prod",
			"label": "npm:prod",
			"isBackground": true,
			"dependsOn": "npm:build",
			"problemMatcher": [
				{
					"owner": "typescript",
					"fileLocation": [
						"relative",
						"${workspaceFolder}"
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": "^.*(Executing task|npm run prod).*$",
						"endsPattern": "^.*(MCP server listening on port).*$"
					},
					"pattern": {
						"regexp": "^(.*\\.js)\\s+\\((\\d+),(\\d+)\\):\\s+(.*)$",
						"file": 1,
						"line": 2,
						"column": 3,
						"message": 4
					}
				}
			],
			"detail": "node ./dist/index.js",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"type": "shell",
			"command": "npm run build",
			"group": "build",
			"problemMatcher": [],
			"label": "npm:build",
			"detail": "tsc && shx chmod +x dist/*.js",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"type": "shell",
			"command": "npm run watch",
			"group": "build",
			"isBackground": true,
			"problemMatcher": "$tsc-watch",
			"label": "npm:watch",
			"detail": "tsc --watch"
		}
	]
}